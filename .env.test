# Used by `vite --mode test`, which is what the Playwright webServer runs.
#
# The URL is same-origin with the dev server on purpose: Playwright's page.route
# does not intercept CORS preflights, so pointing the stub at a cross-origin host
# would make every mocked POST fail. Nothing here ever reaches a real Supabase.
#
# Port 5174 must match `PORT` in playwright.config.ts.
VITE_SUPABASE_URL=http://localhost:5174/supabase-stub
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_stub
